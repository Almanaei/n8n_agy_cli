    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const row = items[i].json;\n  const appId = row[\"Application ID\"];\n  const status = row[\"Status\"];\n  const alertSent = row[\"Alert Sent\"];\n  \n  if (appId && status && status !== \"Pending\" && alertSent !== \"Yes\") {\n    output.push({\n      json: {\n        rowNumber: i + 2, // Row index 0 is line 2\n        appId,\n        \"Application ID\": appId,\n        serviceName: row[\"Service Name\"],\n        firstName: row[\"User First Name\"],\n        lastName: row[\"User Last Name\"],\n        whatsapp: row[\"User WhatsApp Number\"],\n        email: row[\"User Email\"],\n        status,\n        modificationDetails: row[\"Modification Details\"] || \"\",\n        trackingLink: row[\"Tracking Link\"] || \"\"\n      }\n    });\n  }\n}\nreturn output;"
      },
